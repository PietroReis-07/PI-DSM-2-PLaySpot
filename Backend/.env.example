# Copie este arquivo para ".env" e ajuste os valores. NUNCA suba o .env para o GitHub.

PORT=3000
NODE_ENV=development

# Banco de dados MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=playspot

# Segredo usado para assinar o login (JWT). Em produção use um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-isto-por-um-segredo-grande
JWT_EXPIRES_IN=7d

# Pasta onde as fotos das arenas são salvas (padrão: Backend/uploads).
# Em hospedagem na nuvem, aponte para um disco persistente (ex.: /data/uploads).
# UPLOADS_DIR=

# Origem permitida no CORS (só necessário se o frontend rodar em outro endereço,
# ex.: Live Server). Vazio = libera qualquer origem.
# CORS_ORIGIN=http://127.0.0.1:5500
